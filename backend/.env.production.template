# ══════════════════════════════════════════════════════════
# EmbedAI — Production .env Template for AWS EC2
# Copy this to backend/.env on your EC2 instance and fill in values
# DO NOT commit secrets to GitHub!
# ══════════════════════════════════════════════════════════

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# JWT (generate a new secret for production!)
# Run: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=GENERATE_A_NEW_SECRET_HERE
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080

# Groq
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Qdrant Cloud (from cloud.qdrant.io)
# DO NOT add https:// — the code adds it automatically
QDRANT_HOST=your-cluster-id.aws.cloud.qdrant.io
QDRANT_PORT=6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# CORS — your Vercel frontend URL
FRONTEND_URL=https://getembedai.vercel.app
