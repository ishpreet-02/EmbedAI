# ══════════════════════════════════════════════════════════
# PRODUCTION .env — Add these as Environment Variables on Render
# DO NOT commit this file to GitHub
# ══════════════════════════════════════════════════════════

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# JWT (generate a new random secret for production!)
# Run: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=GENERATE_A_NEW_SECRET_HERE
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Groq
GROQ_API_KEY=gsk_your_groq_key_here

# Qdrant Cloud (from cloud.qdrant.io)
QDRANT_HOST=your-cluster-id.aws.cloud.qdrant.io
QDRANT_PORT=6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# CORS — your Vercel frontend URL (required for dashboard auth/API calls)
FRONTEND_URL=https://getembedai.vercel.app

# Optional: comma-separated extra allowed origins (preview deploys, custom domains)
# CORS_ORIGINS=https://getembedai-git-main.vercel.app

