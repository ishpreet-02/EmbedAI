# ══════════════════════════════════════════════════════════
# PRODUCTION .env — copy this to backend/.env on your EC2
# Fill in your actual values (regenerate all keys first!)
# ══════════════════════════════════════════════════════════

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# JWT (generate a new random secret for production!)
# Run: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=GENERATE_A_NEW_SECRET_HERE
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Groq
GROQ_API_KEY=gsk_your_groq_key_here

# Qdrant — Docker service name (NOT localhost in production)
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Redis — Docker service name
REDIS_URL=redis://redis:6379/0

# CORS — your Vercel frontend URL
FRONTEND_URL=https://your-app.vercel.app
